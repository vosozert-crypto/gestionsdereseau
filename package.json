{
  "name": "netmanager-pro",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Network Operations Center - Asset Management & Monitoring",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cd server && npm run dev",
    "seed": "cd server && npm run seed",
    "clean": "rm -rf dist server/dist server/data",
    "lint": "tsc --noEmit",
    "setup": "cd deploy && sudo ./setup.sh",
    "deploy": "cd deploy && sudo ./deploy.sh",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:start": "cd server && npm start"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^9.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
